# game data — never committed in the clear (split archives with pinned hashes may be; PROJECT.md §9)
original/

# generated by MERGE and BUILD. PROJECT.md §2 says which outputs, if any, are tracked; add
# negations for those (e.g. !build/*_merged.txt). Translator branches never commit build/ either way.
build/*
!build/.gitkeep

# python
__pycache__/
*.pyc

# subagent worktrees created by the /translate loop
.claude/worktrees/
